{
  "policy_version": 1,
  "phase": "4-engine-isolation",
  "canonical_manifest": {
    "distribution": "engine",
    "member_rewrites": {
      "sdist": {},
      "wheel": {
        "LICENSE": "open_brain_engine-0.1.0.dist-info/licenses/LICENSE",
        "NOTICE": "open_brain_engine-0.1.0.dist-info/licenses/NOTICE"
      }
    },
    "path": "docs/v0-package-classification.json",
    "project_root": "packages/engine"
  },
  "default_python_artifacts": {
    "wheel": {
      "configured_package_roots": [
        "src/open_brain_engine"
      ],
      "configured_exclusions": [],
      "force_includes": {},
      "required_members": [
        "open_brain_engine/__init__.py",
        "open_brain_engine/engine/__init__.py"
      ],
      "required_trees": [
        {
          "source": "packages/engine/src/open_brain_engine/portable/schemas/v1",
          "destination": "open_brain_engine/portable/schemas/v1"
        },
        {
          "source": "packages/engine/src/open_brain_engine/portable/conformance/v1",
          "destination": "open_brain_engine/portable/conformance/v1"
        }
      ],
      "forbidden_member_patterns": [
        "docs/ai/**",
        "open_brain/**",
        "open_brain_connectors/**",
        "open_brain_legacy/**",
        "**/.open-brain/**",
        "**/credentials/**",
        "**/*.db",
        "**/*.sqlite",
        "**/*.sqlite3"
      ],
      "generated_member_patterns": [
        "open_brain_engine-*.dist-info/METADATA",
        "open_brain_engine-*.dist-info/RECORD",
        "open_brain_engine-*.dist-info/WHEEL"
      ],
      "status": "engine-isolated-unpublished"
    },
    "sdist": {
      "configured_includes": [
        "/pyproject.toml",
        "/src/open_brain_engine"
      ],
      "configured_exclusions": [
        "/.gitignore"
      ],
      "force_includes": {
        "../../release/phase4-compatibility.json": "release/phase4-compatibility.json",
        "../../release/phase4-toolchain.json": "release/phase4-toolchain.json",
        "../../release/public-history-allowlist.json": "release/public-history-allowlist.json",
        "../../release/v0-artifact-policy.json": "release/v0-artifact-policy.json"
      },
      "required_members": [
        "src/open_brain_engine/__init__.py",
        "src/open_brain_engine/engine/__init__.py"
      ],
      "required_trees": [
        {
          "source": "packages/engine/src/open_brain_engine/portable/schemas/v1",
          "destination": "src/open_brain_engine/portable/schemas/v1"
        },
        {
          "source": "packages/engine/src/open_brain_engine/portable/conformance/v1",
          "destination": "src/open_brain_engine/portable/conformance/v1"
        }
      ],
      "forbidden_member_patterns": [
        "docs/ai/**",
        "src/open_brain/**",
        "src/open_brain_connectors/**",
        "src/open_brain_legacy/**",
        "**/.open-brain/**",
        "**/credentials/**",
        "**/*.db",
        "**/*.sqlite",
        "**/*.sqlite3"
      ],
      "generated_member_patterns": [
        "PKG-INFO"
      ],
      "status": "engine-isolated-unpublished"
    }
  },
  "build_hook": "packages/engine/hatch_build.py",
  "target_release_exclusions": [
    "open_brain/dev/**",
    "open_brain/migrate/**",
    "open_brain/parity/**",
    "open_brain/operations/cutover.py",
    "open_brain/operations/cutover_doctor.py",
    "open_brain/operations/cutover_verification.py",
    "open_brain/operations/shadow.py",
    "open_brain/providers/optional_cloud.py",
    "open_brain/production/imessage.py",
    "open_brain/production/optional_automation.py",
    "open_brain/production/project_commit_bridge.py",
    "open_brain/production/youtube_bridge.py",
    "open_brain/production/youtube_poll.py",
    "open_brain/production/media.py",
    "open_brain/capture/extractors/social.py",
    "open_brain/capture/extractors/youtube.py",
    "open_brain/integrations/dev_workflows.py",
    "open_brain/integrations/finance.py",
    "open_brain/integrations/hooks.py",
    "open_brain/integrations/life_os.py",
    "open_brain/integrations/life_os_runtime.py",
    "open_brain/integrations/mail_calendar.py",
    "open_brain/integrations/messaging.py",
    "open_brain/integrations/messaging_runtime.py",
    "open_brain/integrations/obsidian.py",
    "open_brain/operations/optional_jobs.py"
  ],
  "hosts": {
    "supported": [
      {
        "artifact": "macos-arm64",
        "architecture": "arm64",
        "operating_system": "macOS",
        "versions": ">=14"
      },
      {
        "artifact": "linux-x86_64",
        "architecture": "x86_64",
        "operating_system": "Ubuntu",
        "versions": [
          "24.04 LTS",
          "26.04 LTS"
        ]
      },
      {
        "artifact": "linux-x86_64",
        "architecture": "x86_64",
        "operating_system": "Debian",
        "versions": [
          "13"
        ]
      }
    ],
    "unsupported": [
      "macos-x86_64",
      "linux-arm64",
      "windows"
    ]
  },
  "native_artifacts": {
    "bundler_candidate": "PyInstaller 6 onedir",
    "fallback": "Nuitka standalone",
    "published": [],
    "status": "pending-phase-4-spike"
  }
}
