{
  "schema_version": 1,
  "candidate_version": "0.1.0",
  "portable_schema": {
    "maximum": 1,
    "minimum": 1
  },
  "workspace": {
    "activation_wave": "P4-W1",
    "build_backend": {
      "backend": "hatchling.build",
      "version": "1.32.0"
    },
    "build_command": [
      "uv",
      "build",
      "--no-sources"
    ],
    "lockfile": "uv.lock",
    "members": [
      "packages/app",
      "packages/connectors",
      "packages/engine",
      "packages/legacy"
    ],
    "uv_version": "0.12.8"
  },
  "native": {
    "build_python": "3.12",
    "fallback": {
      "activation": "bounded-pyinstaller-failure-gate",
      "mode": "standalone",
      "name": "Nuitka",
      "version": "4.2"
    },
    "primary": {
      "hooks_name": "pyinstaller-hooks-contrib",
      "hooks_version": "2026.7",
      "mode": "onedir",
      "name": "PyInstaller",
      "version": "6.22.2"
    }
  },
  "runners": {
    "linux-x86_64": {
      "architecture": "x86_64",
      "image": "ubuntu-24.04",
      "status": "verified-from-successful-ci-log"
    },
    "macos-arm64": {
      "architecture": "arm64",
      "image": "macos-14-arm64",
      "status": "verified-from-successful-ci-log"
    }
  },
  "signing": {
    "developer_id_application": "available-on-laptop",
    "notary_credentials": "required-not-ready",
    "notarytool": "available"
  },
  "audits": [
    "artifact-policy",
    "complete-history",
    "license-and-sbom",
    "release-audit",
    "secret-scan"
  ]
}
