# Open Brain environment variables
# Copy to .env for local development. Never commit real values.

# Phase 2 single-user profile: one absolute private Brain root.
OPEN_BRAIN_ROOT=/path/to/private/brain-root

# Retained legacy/application composition. Keep these roots distinct and private.
OPEN_BRAIN_CONFIG=/path/to/private/config.toml
OPEN_BRAIN_STATE_ROOT=/path/to/private/state
OPEN_BRAIN_WORK_ROOT=/path/to/private/work
OPEN_BRAIN_PERSONAL_ROOT=/path/to/private/personal
OPEN_BRAIN_CAPTURE_ROOT=/path/to/private/captures
OPEN_BRAIN_SAVED_CONTENT_ROOT=/path/to/private/saved-content
OPEN_BRAIN_BACKUP_ROOT=/path/to/private/backups
OPEN_BRAIN_HOST_IDENTITY=host-example
# Retained composition only; the single-user profile fixes provider mode to none.
OPEN_BRAIN_PROVIDER=local
OPEN_BRAIN_CLOUD_ENABLED=false
OPEN_BRAIN_EGRESS_ENABLED=false

# Retained synthetic connector proof. The installed Phase 2 CLI does not select scheduled routes.
# OPEN_BRAIN_JOB_ID=JOB-029
# OPEN_BRAIN_YOUTUBE_CONFIG=/path/to/private/youtube-config.json

# Scoped MCP and local HTTP settings.
OPEN_BRAIN_MCP_ALLOWED_SPACE_IDS='[]'
OPEN_BRAIN_UI_BIND=127.0.0.1
OPEN_BRAIN_UI_PORT=8788
OPEN_BRAIN_UI_ALLOW_PRIVATE=false

# Retained scheduled/service references. Use private owner-only files when enabled.
OPEN_BRAIN_PROVIDER_CONFIG=/path/to/private/provider-config.json
OPEN_BRAIN_UI_CONFIG=/path/to/private/ui-config.json
OPEN_BRAIN_INGRESS_CONFIG=/path/to/private/ingress-config.json
OPEN_BRAIN_IMESSAGE_CONFIG=/path/to/private/imessage-config.json
OPEN_BRAIN_RETENTION_CONFIG=/path/to/private/retention-config.json
OPEN_BRAIN_LIFEOS_CONFIG=/path/to/private/lifeos-config.json
OPEN_BRAIN_MESSAGES_CONFIG=/path/to/private/messages-config.json
