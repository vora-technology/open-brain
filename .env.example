# Open Brain environment variables
# Copy to .env for local development. Never commit real values.

OPEN_BRAIN_ROOT=/path/to/private/brain-root
OPEN_BRAIN_CONFIG=/path/to/config.toml
OPEN_BRAIN_STATE_ROOT=/path/to/private/state
OPEN_BRAIN_CONTENT_ROOT=/path/to/private/content
OPEN_BRAIN_PROVIDER=local
OPEN_BRAIN_CLOUD_ENABLED=false
OPEN_BRAIN_EGRESS_ENABLED=false
