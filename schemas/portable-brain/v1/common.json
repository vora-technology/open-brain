{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-brain:portable-brain:v1:common",
  "$defs": {
    "action_id": {
      "type": "string",
      "pattern": "^action_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^actor_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "batch_id": {
      "type": "string",
      "pattern": "^batch_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capture_id": {
      "type": "string",
      "pattern": "^capture_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^decision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^event_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "export_id": {
      "type": "string",
      "pattern": "^export_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "measurement_id": {
      "type": "string",
      "pattern": "^measurement_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "page_id": {
      "type": "string",
      "pattern": "^page_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^proposal_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "publication_id": {
      "type": "string",
      "pattern": "^publication_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "route_id": {
      "type": "string",
      "pattern": "^route_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "receipt": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "capture_accepted",
            "routing",
            "privacy_change",
            "proposal_created",
            "decision",
            "publication",
            "external_action"
          ]
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^receipt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "payload",
        "receipt_id",
        "recorded_at",
        "sha256",
        "subject_id"
      ],
      "additionalProperties": false
    },
    "role_claim": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/actor_id"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "uniqueItems": true
        },
        "role_claim_id": {
          "type": "string",
          "pattern": "^role_claim_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "role_id": {
          "type": "string",
          "pattern": "^role_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "tenant_id": {
          "$ref": "#/$defs/tenant_id"
        }
      },
      "required": [
        "actor_id",
        "capabilities",
        "role_claim_id",
        "role_id",
        "tenant_id"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "object",
          "properties": {
            "cloud": {
              "type": "boolean"
            },
            "external_egress": {
              "type": "boolean"
            }
          },
          "required": [
            "cloud",
            "external_egress"
          ],
          "additionalProperties": false
        },
        "confirmation_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "public",
            "work",
            "personal",
            "secret",
            "unknown"
          ]
        }
      },
      "required": [
        "authority",
        "confirmation_ref",
        "policy_version",
        "reason",
        "tier"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "content_origin": {
          "enum": [
            "owner_authored",
            "third_party",
            "mixed",
            "unknown"
          ]
        },
        "owner_context": {
          "enum": [
            "owner_authored",
            "automation_absent"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "transformation_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receipt"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "content_origin",
        "owner_context",
        "source_ref",
        "transformation_receipts"
      ],
      "additionalProperties": false
    },
    "space_id": {
      "type": "string",
      "pattern": "^space_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "trust": {
      "type": "object",
      "properties": {
        "assessed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "assessor_actor_id": {
          "$ref": "#/$defs/actor_id"
        },
        "label": {
          "enum": [
            "owner",
            "third_party",
            "unverified",
            "reviewed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assessed_at",
        "assessor_actor_id",
        "label",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
