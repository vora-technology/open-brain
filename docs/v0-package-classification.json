  "rules": [
    {
      "id": "engine-to-app",
      "source": {
        "owners": [
          "engine"
        ]
      },
      "violations": [
        {
          "target": {
            "owners": [
              "app",
              "connector",
              "hosted",
              "legacy",
              "workspace"
            ]
          }
        }
      ],
      "rationale": "Engine files cannot import application, connector, hosted, legacy, or workspace files."
    },
    {
      "id": "app-to-engine-internals",
      "source": {
        "owners": [
          "app"
        ]
      },
      "violations": [
        {
          "target": {
            "owners": [
              "engine"
            ],
            "apis": [
              "internal"
            ]
          }
        }
      ],
      "rationale": "Application files import only declared public engine and Portable surfaces."
    },
    {
      "id": "connector-capability-only",
      "source": {
        "owners": [
          "connector"
        ]
      },
      "violations": [
        {
          "target": {
            "owners": [
              "engine"
            ],
            "apis": [
              "internal"
            ],
            "roles_none": [
              "extension_contract"
            ]
          }
        },
        {
          "target": {
            "owners": [
              "app",
              "hosted",
              "legacy",
              "workspace"
            ],
            "roles_none": [
              "extension_contract"
            ]
          }
        }
      ],
      "rationale": "Connectors use only their extension contract and public engine values."
    },
    {
      "id": "shipping-to-legacy",
      "source": {
        "owners": [
          "engine",
          "app",
          "connector",
          "hosted"
        ]
      },
      "violations": [
        {
          "target": {
            "owners": [
              "legacy"
            ]
          }
        }
      ],
      "rationale": "Default shipping owners cannot import predecessor-only code."
    },
    {
      "id": "hosted-to-local-internals",
      "source": {
        "owners": [
          "hosted"
        ]
      },
      "violations": [
        {
          "target": {
            "owners": [
              "engine"
            ],
            "apis": [
              "internal"
            ]
          }
        },
        {
          "target": {
            "owners": [
              "app",
              "connector",
              "legacy",
              "workspace"
            ]
          }
        }
      ],
      "rationale": "Hosted code can use public engine and Portable surfaces, not local internals."
    },
    {
      "id": "representation-to-adapters",
      "source": {
        "roles_any": [
          "representation"
        ]
      },
      "violations": [
        {
          "target": {
            "roles_any": [
              "adapter",
              "composition",
              "provider",
              "store",
              "transport",
              "writer"
            ]
          }
        }
      ],
      "rationale": "Representations cannot import concrete adapters or composition."
    },
    {
      "id": "adapter-to-adapter",
      "source": {
        "roles_any": [
          "adapter"
        ]
      },
      "violations": [
        {
          "target": {
            "roles_any": [
              "adapter"
            ]
          },
          "relation": "different-adapter-group"
        }
      ],
      "rationale": "External adapter groups cannot import one another in either direction."
    },
    {
      "id": "runtime-to-workspace",
      "source": {
        "owners": [
          "engine",
          "app",
          "connector",
          "hosted",
          "legacy"
        ]
      },
      "violations": [
        {
          "target": {
            "owners": [
              "workspace"
            ]
          }
        }
      ],
      "rationale": "Runtime files cannot import development or workspace tooling."
    }
  ],
